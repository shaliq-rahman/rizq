# Copy to .env.local for local dev; on Vercel add the same names under Project → Settings → Environment Variables.
# Firebase console → Project settings → General → Your apps → Web app → SDK config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Already defaulted to your project (rizq-dcc33); only set these if you want to override:
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=rizq-dcc33
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=rizq-dcc33.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=rizq-dcc33.firebasestorage.app
